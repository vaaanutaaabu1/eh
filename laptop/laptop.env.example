# ---- Laptop file server + backups (keep this file on your laptop only: it has passwords) ----

# Secret shared between the website and this laptop. Put the SAME value in the website's settings as FILE_STORE_TOKEN.
FILE_STORE_TOKEN=CHANGE_ME_long_random_secret
FILE_STORE_PORT=8787

# Where uploaded files are stored on the laptop. Point it at the big 6-8 TB drive, e.g.  D:\LibData
# (default: the laptop-data folder inside this project)
LAPTOP_DATA=
# Where backups go (database dumps + a copy of every file). Default: the "backups" folder in this project.
# Best: a DIFFERENT disk than LAPTOP_DATA, e.g.  E:\LibBackups   (same disk = no protection if that disk dies)
BACKUP_DIR=
KEEP_DAILY=30

# Your Neon databases = the website's DATABASE_URL1 (and DATABASE_URL2.. if it has them). These are backed up every hour,
# and old files still stored in them are moved to the laptop by "npm run laptop:migrate-files".
# After the move is finished, delete the LIVE_DATABASE_URL2.. lines so the backups stay small.
LIVE_DATABASE_URL1='postgresql://USER:PASSWORD@HOST/neondb?sslmode=require'
# LIVE_DATABASE_URL2=

# pg_dump runs inside a small Docker image (nothing to install except Docker Desktop). Without Docker: install PostgreSQL 17 client tools and set PG_MODE=native
PG_MODE=docker
PG_IMAGE=postgres:17
