+  try {
+    await run(process.env.GS_BIN || "gs", ["-q", "-dNOPAUSE", "-dBATCH", "-dSAFER", "-sDEVICE=pdfwrite", "-dCompatibilityLevel=1.5", "-dDetectDuplicateImages=true", "-dSubsetFonts=true", "-dCompressFonts=true",
